FROM ghcr.io/astral-sh/uv:0.9.5 AS uv
FROM rust:1.90.0-slim-bookworm AS rust
FROM python:3.12.12-slim-bookworm
LABEL org.opencontainers.image.authors="Levent Çelik (@levend18)" \
      org.opencontainers.image.url="https://github.com/levend18" \
      org.opencontainers.image.source="https://github.com/levend18/ledgerbridge-loan-adapter" \
      org.opencontainers.image.title="LedgerBridge"
RUN apt-get update && apt-get install -y --no-install-recommends git curl jq ca-certificates build-essential && rm -r /var/lib/apt/lists/*
RUN git config --global --add safe.directory /app
COPY --from=uv /uv /uvx /usr/local/bin/
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/opt/venv CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup CARGO_TARGET_DIR=/opt/rust-target PATH="/opt/venv/bin:/usr/local/cargo/bin:$PATH"
RUN rustup component add rustfmt clippy
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen
COPY adapter/quality/engine /app/adapter/quality/engine
RUN --mount=type=cache,target=/usr/local/cargo/registry maturin build --release --locked --features extension-module --manifest-path adapter/quality/engine/Cargo.toml --out /tmp/wheels && uv pip install --python /opt/venv/bin/python /tmp/wheels/*.whl
COPY . .
CMD ["python", "-m", "pytest", "tests/unit", "-q"]
